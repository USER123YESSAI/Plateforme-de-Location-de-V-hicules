# ==============================================================================
# CONFIGURATION DE PRODUCTION - BACKEND LARAVEL SUR RENDER
# ==============================================================================

APP_NAME="Location Express"
APP_ENV=production
APP_KEY=base64:Cp677/vtSe/XWBR22AcUuL/n08dKm6g02xUScFxUkVI=
APP_DEBUG=false
APP_URL=https://votre-backend-api.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ==============================================================================
# CONNEXION BASE DE DONNÉES CLOUD TiDB (MySQL Compatible)
# ==============================================================================
# Récupérez ces informations depuis TiDB Cloud Console -> Votre Cluster -> Connect
DB_CONNECTION=mysql
DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=test
DB_USERNAME=votre_prefixe.root
DB_PASSWORD=VOTRE_MOT_DE_PASSE_TIDB

# Configuration SSL TiDB (géré automatiquement par ca-certificates dans Docker)
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# ==============================================================================
# AUTHENTIFICATION & SÉCURITÉ JWT
# ==============================================================================
JWT_SECRET=sPKHqQeFskR9lBMa784GPDd9V87vN2FGHw3YNFUY4Dxo6f5gf2ttZYLEP8Tib3b4
JWT_TTL=1440

# ==============================================================================
# CORS (AUTORISATION DU FRONTEND VERCEL)
# ==============================================================================
# Renseignez ici l'URL de votre site Vercel (séparées par des virgules si plusieurs)
CORS_ALLOWED_ORIGINS=https://votre-site.vercel.app,http://localhost:3000

# ==============================================================================
# STOCKAGE & SESSIONS
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# ==============================================================================
# PASSERELLE DE PAIEMENT CHARIOW (MOBILE MONEY & CARTE)
# ==============================================================================
# Clés API Chariow générées depuis votre tableau de bord (app.chariow.com -> Développeurs)
CHARIOW_API_KEY=votre_cle_api_chariow
CHARIOW_WEBHOOK_SECRET=votre_secret_webhook_chariow
CHARIOW_PRODUCT_ID=votre_id_produit_chariow
CHARIOW_BASE_URL=https://api.chariow.com/v1
FRONTEND_URL=https://votre-site.vercel.app

