# ==============================================================================
# CONFIGURATION DE PRODUCTION - FRONTEND NEXT.JS (EX: VERCEL)
# ==============================================================================

# URL de l'API Backend hébergée sur Render (avec /api à la fin)
# Exemple : https://location-express-backend.onrender.com/api
NEXT_PUBLIC_API_URL=https://votre-backend-sur-render.onrender.com/api

# URL publique de production de votre site web (sans slash final)
# Utilisée par robots.txt, sitemap.xml, balises canonicals et Schema.org JSON-LD
NEXT_PUBLIC_SITE_URL=https://toumaidrive.td

# Clé de vérification Google Search Console (facultatif au début)
# Renseigner la valeur du code fourni par Google (content="VOTRE_CODE")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
